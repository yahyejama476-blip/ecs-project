# Terraform state (can contain secrets)
*.tfstate
*.tfstate.*

# Terraform working directory (provider downloads)
.terraform/

# Variable files that may hold real values
*.tfvars
*.tfvars.json

# Saved plans and crash logs
*.tfplan
crash.log
crash.*.log

# Secrets and keys
.env
*.pem
*.key

# OS junk
Thumbs.db
.DS_Store